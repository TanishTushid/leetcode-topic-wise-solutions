class Solution:
    def maximumImportance(self, n: int, roads: list[list[int]]) -> int:
        degree = [0]*n
        for u, v in roads:
            degree[u] +=1
            degree[v] +=1
        degree.sort()
        total=0
        for i in range(n):
            total+=degree[i]*(i+1)
        return total 
