class Solution:
    def exist(self, board: List[List[str]], word: str) -> bool:
        row = len(board)
        col = len(board[0])
        visited = set()
        direction = [
            (0,1),
            (-1,0),
            (1,0),
            (0,-1)
        ]
        def dfs(r, c, index):
            #boundary check 
            if r < 0 or r >= row or c < 0 or c >= col:
                return False
            #visited check
            if (r,c) in visited:
                return False
            #character check
            if board[r][c] != word[index]:
                return False
            #word completely match
            if index == len(word)-1:
                return True 
            #visited check
            visited.add((r,c))
            for dr, dc in direction:
                nr = r + dr
                nc = c + dc
                if dfs(nr, nc , index +1):
                    return True
            visited.remove((r, c))
            return False
        for i in range(row):
            for j in range(col):
                if board[i][j] == word[0]:
                    if dfs(i, j, 0):
                        return True
        return False
