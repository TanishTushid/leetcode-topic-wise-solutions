class Solution:
    def myPow(self, x: float, n: int) -> float:

        #base case 
        if n == 0:
            return 1
        #handle negitive power 
        if n < 0:
            return 1 / self.myPow(x, -n)
        #hypothesis 
        half = self.myPow(x, n // 2)
        #induction
        if n % 2 == 0:
            return half * half
        else:
            return x * half * half
