class Solution:
    def kthSmallest(self, root: Optional[TreeNode], k: int) -> int:

        self.k = k

        def inorder(root):

            # B — Base case
            if not root:
                return None

            # H — Hypothesis
            left = inorder(root.left)

            # I — Induction
            if left is not None:
                return left

            self.k -= 1

            if self.k == 0:
                return root.val

            # H — Right subtree
            return inorder(root.right)

        return inorder(root)
