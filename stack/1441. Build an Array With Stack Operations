class Solution:
    def buildArray(self, target: list[int], n: int) -> list[str]:
        stack = []
        ans = []
        for i in range(1, n+1):
            stack.append(i)
            ans.append("Push")
            if i not in target:
                stack.pop()
                ans.append("Pop")
            if len(stack) == len(target):
                break
        return ans 
