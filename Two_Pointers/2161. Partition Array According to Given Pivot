class Solution:
    def pivotArray(self, nums: List[int], pivot: int) -> List[int]:
        less_than = []
        greater_than = []
        equal = []
        for num in nums:
            if num < pivot:
                less_than.append(num)
            elif num > pivot:
                greater_than.append(num)
            else:
                equal.append(num)
        less_than.extend(equal)
        less_than.extend(greater_than)
        return less_than 
