class Solution:
    def missingInteger(self, nums: List[int]) -> int:
        
        hashtable = {}
        for num in nums:
            hashtable[num] = hashtable.get(num, 0) + 1
        sequential = []   # store numbers
        for num in hashtable:
            if not sequential:       # first number
                sequential.append(num)
            elif num == sequential[-1] + 1:
                sequential.append(num)
            else:
                break
        ans = sum(sequential)
        while ans in hashtable:
            ans += 1
        return ans
