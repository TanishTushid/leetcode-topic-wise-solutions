class Solution:
    def canConstruct(self, ransomNote: str, magazine: str) -> bool:
        
        hashtable = {}

        for ch in magazine:
            hashtable[ch] = hashtable.get(ch, 0)+1
        for ch in ransomNote:
            if ch not in hashtable or hashtable[ch] == 0:
                return False
            hashtable[ch] -=1
        return True
