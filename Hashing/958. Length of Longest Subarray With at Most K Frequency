class Solution:
    def maxSubarrayLength(self, nums: List[int], k: int) -> int:
        freq = {}
        left = 0
        longest = 0
        for right, value in enumerate(nums):
            freq[value] = freq.get(value,0)+1
            while freq[value]>k:
                freq[nums[left]] -=1
                left +=1
            longest = max(longest, right-left+1)
        return longest
