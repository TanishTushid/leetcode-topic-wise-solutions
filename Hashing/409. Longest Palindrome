class Solution:
    def longestPalindrome(self, s: str) -> int:
        hashtable = {}
        for ch in s:
            hashtable[ch] = hashtable.get(ch, 0)+1
        length = 0
        odd = False
        for ch in hashtable:
            count = hashtable[ch]
            length += (count // 2)*2
            if count %2 == 1:
                odd = True
        if odd:
            length +=1
        return length 
