class Solution:
    def totalFruit(self, fruits: List[int]) -> int:

        fruit_tree = {}
        left = 0
        ans = 0

        for right in range(len(fruits)):

            fruit_tree[fruits[right]] = fruit_tree.get(fruits[right], 0) + 1

            while len(fruit_tree) > 2:
                fruit_tree[fruits[left]] -= 1

                if fruit_tree[fruits[left]] == 0:
                    del fruit_tree[fruits[left]]

                left += 1

            ans = max(ans, right - left + 1)

        return ans
